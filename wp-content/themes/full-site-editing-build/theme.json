{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#212121",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#1268b3",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#ed1c29",
					"name": "Secondary"
				},
				{
					"slug": "light-blue",
					"color": "#f7f8ff",
					"name": "Light Blue"
				},
				{
					"slug": "light-blue-2",
					"color": "#b0daff",
					"name": "Light Blue 2"
				},
				{
					"slug": "blue-2",
					"color": "#3d6d9e",
					"name": "Blue 2"
				},
				{
					"slug": "gray",
					"color": "#bdbdbd",
					"name": "Gray"
				},
				{
					"slug": "body-text",
					"color": "#6c757d",
					"name": "Body Text"
				},
				{
					"slug": "dark",
					"color": "#181818",
					"name": "Dark"
				},
				{
					"slug": "accent",
					"color": "#f6f6f6",
					"name": "Accent"
				},
				{
					"slug": "border",
					"color": "#dedede",
					"name": "Border"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"textColumns": false,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "primary",
					"fontFamily": "'Inter', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./src/fonts/inter-variablefont.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "100 700",
							"fontStyle": "italic",
							"fontStretch": "normal",
							"src": [
								"file:./src/fonts/inter-variablefont-italic.woff2"
							]
						}
					]
				},
				{
					"name": "System UI",
					"slug": "system",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "xs",
					"name": "Extra Small",
					"size": "0.75rem",
					"fluid": false
				},
				{
					"slug": "sm",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "md",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "lg",
					"name": "Large",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "xl",
					"name": "Extra Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "2xl",
					"name": "2X Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "3xl",
					"name": "3X Large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "4xl",
					"name": "4X Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "5xl",
					"name": "5X Large",
					"size": "4rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4rem"
					}
				},
				{
					"slug": "6xl",
					"name": "6X Large",
					"size": "5.625rem",
					"fluid": {
						"min": "3rem",
						"max": "5.625rem"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "0",
					"name": "0",
					"size": "0"
				},
				{
					"slug": "10",
					"name": "2XS",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "2.5rem"
				},
				{
					"slug": "70",
					"name": "2XL",
					"size": "4rem"
				},
				{
					"slug": "80",
					"name": "3XL",
					"size": "clamp(4rem, 8vw, 7rem)"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Default",
					"slug": "default",
					"shadow": "0 10px 40px 0 rgba(0, 0, 0, 0.2)"
				},
				{
					"name": "Small",
					"slug": "sm",
					"shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)"
				},
				{
					"name": "Large",
					"slug": "lg",
					"shadow": "0 20px 50px -12px rgba(0, 0, 0, 0.25)"
				}
			]
		},
		"custom": {
			"framework": {
				"breakpoints": {
					"xs": "0",
					"sm": "576px",
					"md": "768px",
					"lg": "992px",
					"xl": "1200px",
					"xxl": "1400px"
				},
				"containerMaxWidths": {
					"sm": "540px",
					"md": "720px",
					"lg": "960px",
					"xl": "1140px",
					"xxl": "1320px"
				},
				"halfGap": "12px",
				"containerPaddingX": "0"
			},
			"headerHeight": "70px",
			"borderColor": "#dedede",
			"lineHeight": {
				"none": "1",
				"tight": "1.25",
				"base": "1.625",
				"loose": "1.75"
			},
			"letterSpacing": {
				"tight": "-0.44px",
				"tighter": "-1px",
				"tightest": "-2px",
				"wide": "2px",
				"body": "-0.2px"
			}
		}
	},
	"styles": {
		"color": {
			"text": "var:preset|color|body-text",
			"background": "var:preset|color|base"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|primary",
			"fontSize": "var:preset|font-size|md",
			"fontWeight": "400",
			"lineHeight": "var:custom|line-height|base",
			"letterSpacing": "var:custom|letter-spacing|body"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1rem, 3vw, 3.75rem)",
				"right": "clamp(1rem, 3vw, 3.75rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|primary",
					"fontWeight": "700"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|5xl",
					"lineHeight": "1.0625",
					"letterSpacing": "-2px"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|4xl",
					"lineHeight": "1.111",
					"letterSpacing": "-2px"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|3xl",
					"lineHeight": "1.143",
					"letterSpacing": "-1px"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|2xl",
					"lineHeight": "1.167",
					"letterSpacing": "-1px"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|xl",
					"lineHeight": "1.3"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|lg",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"text": "var:preset|color|base",
					"background": "var:preset|color|primary"
				},
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "700",
					"lineHeight": "1.286"
				},
				"border": {
					"radius": "0",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "24px",
						"right": "24px"
					}
				},
				":hover": {
					"color": {
						"text": "var:preset|color|base",
						"background": "var:preset|color|contrast"
					}
				},
				":focus": {
					"color": {
						"text": "var:preset|color|base",
						"background": "var:preset|color|contrast"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "2px"
						},
						"color": {
							"text": "var:preset|color|primary",
							"background": "transparent"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|sm",
					"fontWeight": "700",
					"letterSpacing": "var:custom|letter-spacing|tight"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|lg",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|border"
				},
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				}
			},
			"core/image": {
				"border": {
					"radius": "5px"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "no-title",
			"title": "No title",
			"postTypes": [
				"post",
				"page"
			]
		}
	],
	"patterns": []
}
